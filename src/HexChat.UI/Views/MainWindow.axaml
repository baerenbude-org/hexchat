<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HexChat.UI.ViewModels"
        xmlns:state="using:HexChat.Core.State"
        x:Class="HexChat.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="HexChat Avalonia"
        Width="1050" Height="680"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Top Toolbar / Connection Bar -->
        <Border Grid.Row="0" Background="#1E1E24" Padding="8,6" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA" />
                <TextBox Grid.Column="1" Text="{Binding ServerName}" Width="150" Margin="0,0,12,0" Height="28" />

                <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA" />
                <TextBox Grid.Column="3" Text="{Binding Port}" Width="60" Margin="0,0,12,0" Height="28" />

                <TextBlock Grid.Column="4" Text="Nick:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAAAAA" />
                <TextBox Grid.Column="5" Text="{Binding Nickname}" Width="130" Margin="0,0,12,0" Height="28" />

                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding UseTls}" Content="SSL/TLS" VerticalAlignment="Center" Foreground="#AAAAAA" />
                    <Button Content="Verbinden"
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding !IsConnected}"
                            Background="#007ACC" Foreground="White" FontWeight="SemiBold"
                            Padding="12,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-Pane Main Layout -->
        <Grid Grid.Row="1" ColumnDefinitions="210, 4, *, 4, 180">
            <!-- Left Pane: Channel & Server Tree -->
            <Border Grid.Column="0" Background="#18181C" BorderBrush="#2D2D35" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CHANNELS &amp; DIALOGE" FontSize="11" FontWeight="Bold" Foreground="#666677" Margin="10,8,0,4" />
                    <ListBox ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel}"
                             Background="Transparent"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ChannelItemViewModel">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium" />
                                    <Border Grid.Column="1"
                                            IsVisible="{Binding HighlightCount, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Background="#E53935" CornerRadius="8" Padding="6,1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding HighlightCount}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="#26262B" ResizeDirection="Columns" />

            <!-- Center Pane: Active Channel Chat & Topic -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <!-- Topic Bar -->
                <Border Grid.Row="0" Background="#222228" Padding="10,6" BorderBrush="#2D2D35" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="Topic:" FontWeight="Bold" Foreground="#0098FF" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedChannel.Topic, FallbackValue='Kein Topic gesetzt'}"
                                   TextTrimming="CharacterEllipsis" Foreground="#CCCCCC" />
                    </Grid>
                </Border>

                <!-- Chat History Messages Viewport -->
                <Border Grid.Row="1" Background="#121214">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedChannel.Messages}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="state:ChatMessage">
                                    <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,2">
                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                   Foreground="#656578" FontFamily="Consolas, Monospace" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Top" />

                                        <!-- Sender Nick or System Tag -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Sender, StringFormat='&lt;{0}&gt;'}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#38BDF8"
                                                   Margin="0,0,8,0" VerticalAlignment="Top" />

                                        <!-- Message Text Content -->
                                        <SelectableTextBlock Grid.Column="2"
                                                             Text="{Binding Text}"
                                                             TextWrapping="Wrap"
                                                             Foreground="#E2E8F0"
                                                             FontFamily="Segoe UI, Inter, sans-serif" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Background="#26262B" ResizeDirection="Columns" />

            <!-- Right Pane: Channel Nick List -->
            <Border Grid.Column="4" Background="#18181C" BorderBrush="#2D2D35" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding SelectedChannel.Users.Count, StringFormat='BENUTZER ({0})'}"
                               FontSize="11" FontWeight="Bold" Foreground="#666677" Margin="10,8,0,4" />
                    <ListBox ItemsSource="{Binding SelectedChannel.Users}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="state:ChannelUser">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding HighestPrefix}" FontWeight="Bold" Foreground="#FFB300" />
                                    <TextBlock Text="{Binding User.Nick}" Foreground="#DDDDDD" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Input & Status Bar -->
        <Border Grid.Row="2" Background="#1E1E24" Padding="8,6" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding InputText, Mode=TwoWay}"
                         PlaceholderText="Nachricht eingeben oder /befehl (/join, /part, /msg, /me, /raw)..."
                         Margin="0,0,8,0" Height="32">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Senden"
                        Command="{Binding SendMessageCommand}"
                        Background="#007ACC" Foreground="White"
                        Height="32" Padding="14,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
