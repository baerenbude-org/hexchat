# Auto-detect text files and normalize line endings to LF in repository
* text=auto

# Source code & script files (always LF)
*.c text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.m text eol=lf diff=objc
*.cs text eol=lf diff=csharp
*.axaml text eol=lf diff=csharp
*.xaml text eol=lf diff=csharp
*.py text eol=lf diff=python
*.lua text eol=lf
*.pl text eol=lf diff=perl
*.pm text eol=lf diff=perl
*.sh text eol=lf
*.bash text eol=lf

# Build and configuration files (LF)
meson.build text eol=lf
meson_options.txt text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.gresource.xml text eol=lf
*.desktop text eol=lf
*.appdata.xml text eol=lf
*.metainfo.xml text eol=lf
*.po text eol=lf
*.pot text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
nuget.config text eol=lf
.editorconfig text eol=lf
.clang-format text eol=lf
.clang-tidy text eol=lf
.yamllint.yaml text eol=lf

# Windows-specific files (always CRLF)
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.rc text eol=crlf
*.manifest text eol=crlf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.mo binary
*.gmo binary
*.7z binary
*.zip binary
*.tar.* binary

# Git archive / release tarball export ignore
.github export-ignore
.vscode export-ignore
.agents export-ignore
AGENTS.md export-ignore
.editorconfig export-ignore
.clang-format export-ignore
.clang-tidy export-ignore
.yamllint.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.mailmap export-ignore
